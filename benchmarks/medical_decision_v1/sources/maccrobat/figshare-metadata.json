{"files": [{"id": 17493650, "name": "MACCROBAT2018.zip", "size": 1064962, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/17493650", "supplied_md5": "453c144879c303d248d74f56b6b40914", "computed_md5": "453c144879c303d248d74f56b6b40914", "mimetype": "application/zip"}, {"id": 21489405, "name": "MACCROBAT2020.zip", "size": 1070089, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/21489405", "supplied_md5": "9d090f3e0719e77e7a33c38750548bb8", "computed_md5": "9d090f3e0719e77e7a33c38750548bb8", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 5714234, "full_name": "J. Harry Caufield", "first_name": "J. Harry", "last_name": "Caufield", "is_active": true, "url_name": "J_Harry_Caufield", "orcid_id": "0000-0001-5705-7831"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/MACCROBAT2018/9764942", "download_disabled": false, "description": "This ZIP-compressed file contains 200 source documents (in plain text, on sentence per line) and 200 annotation documents (in <i>brat </i>standoff format). Documents are named using PubMed document IDs, e.g. \"15939911.txt\" contains text from the document \"A young man with palpitations and Ebstein's anomaly of the tricuspid valve\" by Marcu and Donohue. Text is from PubMed Central full-text documents but has been edited to include only clinical case report details. All annotations were created manually.<div><br></div><div>\"MACCROBAT2020\" is the second release of this dataset, following \"MACCROBAT2018\". The consistency and format of annotations has been improved in the newest version.</div>", "funding": null, "funding_list": [], "version": 2, "status": "public", "size": 2135051, "created_date": "2020-01-30T22:52:29Z", "modified_date": "2020-01-30T22:52:29Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.